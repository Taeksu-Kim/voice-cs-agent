# 토스 원문·AI Hub 데이터는 재배포하지 않는다
data/raw/
data/processed/
# 로컬 벡터 DB (Milvus Lite)
*.db
.env
__pycache__/
*.pyc
.pytest_cache/
# 평가 실행 결과 (통화 기록 포함)
runs/
.pytest_cache/
# LLM 입출력 기록 (서버)
logs/
# 평가 실행 로그 (nohup 출력)
runs_*.log
# 라벨 표본의 판정 입력 (검색 문서 원문·통화 기록 포함 — runs/와 같은 이유로 제외)
labels/**/items.jsonl
labels/*/sample.jsonl
labels/*/part*.jsonl
# 기계별 경로 (scripts/serve.sh가 읽음)
.serve.env
# 개인 기획 메모 (공개 저장소에 올리지 않음)
docs/01_*.md
docs/02_*.md
docs/03_*.md
docs/memo_*.md
